---
import type { Options as FloatOptions } from "../scripts/components/Float/Float.ts";

const floatOptions: FloatOptions = {
  /** translate only, see docs/adr/room-translate-only.md */
  factors: {
    position: 1,
    scale: 0,
  },
  intensity: 5,
  debug: import.meta.env.MODE === 'development',
  willChange: false,
};

---

<div x-data="Room" x-bind="bindings" class="room">
  <div x-data={`Float(${JSON.stringify(floatOptions)})`} x-bind="bindings">
    <div data-slot></div>
  </div>
</div>
